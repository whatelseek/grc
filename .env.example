# Copy to .env and adjust before the first `docker compose up`.
POSTGRES_USER=bia
POSTGRES_PASSWORD=bia
POSTGRES_DB=bia

# Sign JWTs with a long random value: `openssl rand -hex 32`
JWT_SECRET=change-me-in-production

# Bootstrap administrator, created on first start if missing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Port the web UI is published on.
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
